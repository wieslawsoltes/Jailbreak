new file mode 100644
index 0000000000000000000000000000000000000000..b66ecc187d558e46c14dd05e5ac360eddc6bca0d
--- /dev/null
+++ b/tests/workbench.test.js
@@ -0,0 +1,14 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {findText,replaceText,lineOffset,sourcePosition,rankItems,documentSymbols,searchWorkspace,DocumentPositions} from '../packages/workbench/navigation.js';
+import {layoutValues} from '../packages/workbench/layout.js';
+test('literal editor search never interprets regex metacharacters',()=>{assert.deepEqual(findText('a[1] a1 a[1]','a[1]').matches,[{start:0,end:4},{start:8,end:12}]);assert.equal(findText('A a','a',{caseSensitive:true}).matches[0].start,2);});
+test('case insensitive Unicode search retains original UTF-16 offsets',()=>{const text='İ 😀 Kelvin K kelvin';for(const m of findText(text,'kelvin').matches)assert.equal(text.slice(m.start,m.end).toLowerCase(),'kelvin');assert.equal(findText(text,'K').matches[0].start,5);});
+test('whole-word boundaries understand Unicode letters and supplementary codepoints',()=>{assert.equal(findText('x abcX abc abcą 𐐀abc abc_','abc',{wholeWord:true}).matches.length,1);});
+test('replace all treats replacement as literal data and refuses partial replacement',()=>{assert.equal(replaceText('x x','x','$&').after,'$& $&');assert.throws(()=>replaceText('x x','x','y',{maxResults:1}),/Too many/);});
+test('line and column positions use original CRLF and UTF-16 offsets',()=>{const t='A\r\n😀line\nlast';assert.equal(lineOffset(t,2,3),5);assert.equal(lineOffset(t,1,99),1);assert.deepEqual(sourcePosition(t,5),{line:2,column:3});assert.equal(lineOffset(t,99),t.length);assert.throws(()=>lineOffset(t,0));});
+test('workspace search skips binary payloads, reports exact selections and bounded totals',()=>{const f={'b.cs':'line\nfind here\nfind','a.cs':'find','lib.binary.json':'find'};const r=searchWorkspace(f,'find',{maxResults:2});assert.equal(r.rows.length,2);assert.equal(r.truncated,true);for(const m of r.rows)assert.equal(f[m.file].slice(m.start,m.end),'find');assert.equal(r.rows[1].line,2);});
+test('parsed symbol navigation reports CSharp declarations and named XAML only',()=>{const cs='namespace App; public class View { int count=1; public int Run(){return count;} }';assert.ok(documentSymbols(cs,'View.cs').some(s=>s.label==='Run'&&cs.slice(s.start).includes('Run()')));assert.deepEqual(documentSymbols('<StackPanel><Button x:Name="Action"/></StackPanel>','View.axaml').map(s=>s.label),['StackPanel','Action']);assert.deepEqual(documentSymbols('function unknown(){}','app.js'),[]);});
+test('fuzzy file ranking is deterministic and excludes nonmatches',()=>{const items=[{label:'main.cs'},{label:'MainView.axaml'},{label:'Other.cs'}];assert.equal(rankItems(items,'mvax')[0].label,'MainView.axaml');assert.equal(rankItems(items,'unavailable').length,0);});
+test('caret memory is LRU-bounded and clamps after document changes',()=>{const p=new DocumentPositions(2);p.save('a',{start:30,end:40,top:2,left:0});p.save('b',{start:1,end:2});p.save('c',{start:7,end:8});assert.equal(p.positions.size,2);assert.equal(p.get('a',5).start,0);assert.equal(p.get('c',5).end,5);p.clear();assert.equal(p.positions.size,0);});
+test('saved pane sizes cannot inject CSS or exceed bounded limits',()=>{assert.deepEqual(layoutValues({explorer:'20px;display:none',inspector:-2,bottom:Infinity,split:200}),{explorer:230,inspector:280,bottom:160,split:75});});
