+function createDocument(path){
+  if(!path)throw new Error('Enter a source file path');
+  if(!/^[\w .\-/]+\.(cs|a?xaml|csproj|props|targets|slnx)$/.test(path)||path.includes('..')||path.startsWith('/'))throw new Error('Use a relative C#, XAML, project, .props, .targets or .slnx path.');
+  if(Object.hasOwn(files,path)){openFile(path);return;}
+  if(!development.canEdit())throw new Error('Finish or cancel execution/reload before creating files');
+  const text=path.endsWith('.cs')?'namespace MyApp;\npublic class NewClass\n{\n}\n':/\.(csproj|props|targets)$/.test(path)?'<Project/>\n':path.endsWith('.slnx')?'<Solution/>\n':'<UserControl xmlns="https://github.com/avaloniaui">\n  <TextBlock Text="Hello"/>\n</UserControl>\n';
+  // Apply must validate all paths, budgets and collisions before source is changed.
+  journal.commit(files,sourceTransaction([{path,before:null,after:text}],'Create '+path));
+  refreshWorkspace(path);
+}
