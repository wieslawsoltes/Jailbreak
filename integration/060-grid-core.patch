+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {parseGridTracks,gridCss,gridRange} from '../packages/avalonia-runtime/grid-layout.js';
+import {editGrid,inspectGrid} from '../packages/development/grid-editor.js';
+import {EditHistory} from '../packages/development/designer.js';
+import {compileProject} from '../packages/project-system/index.js';
+import {createRuntime} from '../packages/avalonia-runtime/index.js';
+import {planReload,reloadScript} from '../packages/development/reload.js';
+const text='<Grid xmlns="https://github.com/avaloniaui" Name="Layout" RowDefinitions="Auto,*,48" ColumnDefinitions="*,2*"><!--keep--><TextBox Name="Input"/><Button Name="B" Grid.Row="1" Grid.RowSpan="2" Content="Hi"/></Grid>';
+const view=t=>inspectGrid(t,'View.axaml',0);
+test('Grid shorthand preserves zero stars, fractions and default fill track',()=>{assert.equal(gridCss(null),'minmax(0,1fr)');assert.equal(gridCss('0*,Auto,.5*,48'),'minmax(0,0fr) max-content minmax(0,0.5fr) 48px');assert.equal(parseGridTracks('auto,2e2,*')[1].value,200);});
+test('Grid input rejects CSS expressions negative tracks and unbounded tracks',()=>{for(const s of ['-1','1,,2','1fr','1*;color:red','Infinity','NaN','1e99'])assert.throws(()=>parseGridTracks(s));assert.throws(()=>parseGridTracks(Array(129).fill('*').join(','),{maxTracks:128}));});
+test('Grid default placement is origin and spans clamp to the final explicit track',()=>{assert.deepEqual(gridRange(null,null,3),{start:0,span:1});assert.deepEqual(gridRange(8,9,3),{start:2,span:1});assert.deepEqual(gridRange(1,8,3),{start:1,span:2});});
+test('inserting first track remaps even implicit children in one source transaction',()=>{const tx=editGrid(text,'View.axaml',0,{kind:'insert',axis:'rows',index:0,value:32});const m=view(tx.after);assert.deepEqual(m.rows,['32','Auto','*','48']);assert.deepEqual(m.placements.map(p=>p.row),[1,2]);assert.equal(m.placements[1].rowSpan,2);assert.ok(tx.after.includes('<!--keep-->'));});
+test('inserting inside a span grows it while insertion at its end does not',()=>{const a=editGrid(text,'View.axaml',0,{kind:'insert',axis:'rows',index:2}),b=editGrid(text,'View.axaml',0,{kind:'insert',axis:'rows',index:3});assert.equal(view(a.after).placements[1].rowSpan,3);assert.equal(view(b.after).placements[1].rowSpan,2);});
+test('removing a track shifts following controls and shrinks crossing spans',()=>{const a=editGrid(text,'View.axaml',0,{kind:'remove',axis:'rows',index:0});assert.equal(view(a.after).placements[1].row,0);const b=editGrid(text,'View.axaml',0,{kind:'remove',axis:'rows',index:1});assert.equal(view(b.after).placements[1].rowSpan,1);});
+test('track count replacement clamps explicit spans without changing other content',()=>{const tx=editGrid(text,'View.axaml',0,{kind:'tracks',axis:'rows',value:'*'});assert.equal(view(tx.after).placements[1].row,0);assert.equal(view(tx.after).placements[1].rowSpan,1);assert.match(tx.after,/Content="Hi"/);});
+test('cell placement requires a direct child, valid bounds and positive spans',()=>{const offset=text.indexOf('<TextBox');const tx=editGrid(text,'View.axaml',offset,{kind:'cell',row:2,column:1});assert.equal(view(tx.after).placements[0].row,2);for(const r of [{row:9,column:0},{row:0,column:0,rowSpan:0},{row:0,column:1,columnSpan:3}])assert.throws(()=>editGrid(text,'View.axaml',offset,{kind:'cell',...r}));assert.throws(()=>editGrid(text,'View.axaml',0,{kind:'cell',row:0,column:0}));});
+test('bindings and expanded definition objects are protected from destructive simplification',()=>{for(const t of [text.replace('Auto,*,48','{Binding Rows}'),text.replace('Grid.Row="1"','Grid.Row="{Binding Row}"'),text.replace('<!--keep-->','<Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>')])assert.throws(()=>editGrid(t,'View.axaml',0,{kind:'insert',axis:'rows',index:0}),/protect/);});
+test('Grid edits preserve CRLF comments prefixes quotes and source preimages',()=>{const t=text.replace('<TextBox',"\r\n  <TextBox").replace('Content="Hi"',"Content='Hi'");const tx=editGrid(t,'View.axaml',0,{kind:'spacing',rowSpacing:12,columnSpacing:8});assert.match(tx.after,/\r\n/);assert.match(tx.after,/Content='Hi'/);const files={'View.axaml':t},h=new EditHistory();h.apply(files,tx);h.undo(files);assert.equal(files['View.axaml'],t);h.redo(files);assert.equal(files['View.axaml'],tx.after);});
+test('explicit Grid.Children works and the final track cannot be deleted',()=>{const t='<Grid><Grid.Children><Button Name="B"/></Grid.Children></Grid>';assert.equal(inspectGrid(t,'A.xaml',t.indexOf('<Button')).child,true);assert.throws(()=>editGrid(t,'A.xaml',0,{kind:'remove',axis:'rows',index:0}),/final/);});
+test('Grid tracks and index edits hot reload the original input with no duplicate subscriptions',()=>{
+  const before=compileProject({'View.axaml':text},{debug:true}),tx=editGrid(text,'View.axaml',0,{kind:'insert',axis:'rows',index:0,value:'24'}),after=compileProject({'View.axaml':tx.after},{debug:true});assert.equal(before.success,true);assert.equal(after.success,true);
+  const JB=createRuntime();JB.enableDevelopment({debug:before.debug,nativeBreaks:false});new Function('JB',before.code)(JB);JB.root=JB.createFromXaml('View.axaml');const root=JB.root,child=root.Input;child.Text='retained';let calls=0;root.B.Click.add(()=>calls++);
+  const plan=planReload(before,after);assert.equal(plan.compatible,true,JSON.stringify(plan.reasons));new Function('JB',reloadScript(plan,before,after,1).replace('(globalThis.Jailbreak)','(JB)'))(JB);
+  assert.equal(root.Input,child);assert.equal(child.Text,'retained');assert.equal(root.RowDefinitions,'24,Auto,*,48');root.B.raise('Click');assert.equal(calls,1);root.Dispose();
+});
